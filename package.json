{
  "name": "sap_cap_project",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-stockrequests": "cds watch --open stockrequests/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "admin@test.com": {
            "password": "pass",
            "roles": [
              "admin"
            ]
          },
          "manager@test.com": {
            "password": "pass",
            "roles": [
              "manager"
            ]
          },
          "clerk@test.com": {
            "password": "pass",
            "roles": [
              "clerk"
            ]
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/stockrequests"
  ]
}
